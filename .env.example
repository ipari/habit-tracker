# APP_ENV: runtime environment (development, test, or production)
APP_ENV=
# DATABASE_URL: SQLAlchemy SQLite URL; use a Linux path or named-volume path in production
DATABASE_URL=
# HABIT_TRACKER_BIND_ADDRESS / HABIT_TRACKER_PORT: Docker host binding (loopback by default)
HABIT_TRACKER_BIND_ADDRESS=127.0.0.1
HABIT_TRACKER_PORT=8000
# HABIT_TRACKER_USERNAME: the single account login name
HABIT_TRACKER_USERNAME=
# HABIT_TRACKER_PASSWORD_HASH: Argon2id hash generated by app.auth.hash_password
HABIT_TRACKER_PASSWORD_HASH=
# SESSION_SECRET: random secret with at least 32 characters
SESSION_SECRET=
# SESSION_COOKIE_SECURE: true when served through HTTPS
SESSION_COOKIE_SECURE=
# SESSION_TTL_HOURS: login session lifetime in hours
SESSION_TTL_HOURS=
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: generated once with app.push.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: mailto: address or HTTPS URL identifying the push sender
VAPID_SUBJECT=
# REMINDER_POLL_SECONDS: scheduler polling interval (5-300 seconds)
REMINDER_POLL_SECONDS=
# REMINDER_LOOKBACK_MINUTES: due reminder recovery window after short downtime
REMINDER_LOOKBACK_MINUTES=
